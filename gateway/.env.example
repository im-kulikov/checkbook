# cp .env.example .env && chmod 600 .env, then fill in the values. Never commit .env.

# ProxyAPI key (sk-…). Required. Only here: not in the repository, not in chats, not on phones.
PROXYAPI_KEY=

# The private data repository: the gateway lets in only tokens that can open exactly this repository. Required.
GITHUB_REPO=owner/checkbook-data

# The app origin (the custom domain from the GitHub Pages settings), without a trailing "/" or path. Required.
ALLOWED_ORIGIN=https://checkbook.example.ru

# Optional (defaults below)
MODEL=google/gemini-2.5-flash-lite
MAX_COMPLETION_TOKENS=1500
